# ==========================================
# NextHire AI – Global Environment Template
# ==========================================

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://admin:secure_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nexthire_ai

# Security & JWT Authentication
JWT_SECRET=nexthire_ai_super_secret_jwt_key_2026_production_grade_random_seed
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration & Provider Selection
# Options: "gemini" | "openai" | "grok" | "openrouter"
DEFAULT_AI_PROVIDER=gemini

# 1. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 3. Grok (xAI) / GroqCloud API
GROK_API_KEY=your_grok_xai_or_groq_api_key_here
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# 4. OpenRouter AI API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports

# Frontend
VITE_API_URL=/api/v1
